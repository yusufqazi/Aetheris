# Google AI Studio is the preferred provider. Keep this key server-side.
AI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Conservative default for free-tier request-per-minute limits.
GEMINI_MIN_REQUEST_INTERVAL_MS=13000
GEMINI_REQUEST_TIMEOUT_MS=55000

# Optional OpenAI fallback. Set AI_PROVIDER=openai to prefer it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase project configuration. The publishable key is safe for browser use;
# Row Level Security protects user data in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Use only the root Project URL from Supabase Dashboard > Connect, for example
# https://your-project-ref.supabase.co (no /auth/v1 or /rest/v1 suffix).
# Paste the matching Publishable Key from the same screen.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy key name supported for existing Supabase projects. Use only one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only key for trusted administrative jobs. Never expose it to
# the browser and never commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=
