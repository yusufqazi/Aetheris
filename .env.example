# Google AI Studio is the preferred provider. Keep this key server-side.
AI_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Conservative default for free-tier request-per-minute limits.
GEMINI_MIN_REQUEST_INTERVAL_MS=13000
GEMINI_REQUEST_TIMEOUT_MS=55000

# Optional OpenAI fallback. Set AI_PROVIDER=openai to prefer it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
